{
  "name": "uac-live-3d",
  "version": "1.0.0",
  "private": true,
  "description": "UAC-Live 3D — plateforme géospatiale du campus universitaire d'Abomey-Calavi (Bénin)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @uac/server test:integration",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @uac/database generate",
    "db:migrate": "pnpm --filter @uac/database migrate",
    "db:seed": "pnpm --filter @uac/database seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\""
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.6.2",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
