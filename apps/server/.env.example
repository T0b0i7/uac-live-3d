# =============================================================================
# Configuration du serveur UAC-Live 3D
# -----------------------------------------------------------------------------
# Copier en `.env` puis remplacer TOUTES les valeurs de secret :
#
#   cp apps/server/.env.example apps/server/.env
#   openssl rand -base64 48   # à exécuter 3 fois (JWT, refresh, sel IP)
#
# `.env` est ignoré par git — ne jamais le committer.
# =============================================================================

# --- Exécution ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Base de données (PostgreSQL 16+ avec l'extension PostGIS) ---
# PostGIS est OBLIGATOIRE : les colonnes geometry/geography ne s'initialisent
# pas sans lui. Voir docs/deployment.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uac_live

# --- Redis ---
# Redis n'est PAS une source de vérité (ADR-008) : il porte le cache, les
# compteurs de limitation et le bus pub/sub Socket.IO.
#
# REDIS_MODE=optional : si Redis est absent, le serveur démarre avec un cache
#                       mémoire et un temps réel limité à l'instance courante.
# REDIS_MODE=required : le démarrage échoue sans Redis. Obligatoire dès que
#                       plusieurs instances tournent derrière un répartiteur,
#                       sinon un utilisateur connecté sur B ne recevra pas les
#                       alertes émises depuis A.
REDIS_URL=redis://localhost:6379
REDIS_MODE=optional

# --- Secrets (32 caractères minimum, sans valeur connue) ---
# En production le serveur REFUSE de démarrer si ces valeurs contiennent un
# motif faible (« secret », « changeme », « password »…).
JWT_SECRET=remplacer-par-openssl-rand-base64-48
JWT_REFRESH_SECRET=remplacer-par-openssl-rand-base64-48
# Sel de hachage des adresses IP dans les journaux d'audit : l'IP n'est jamais
# stockée en clair.
IP_HASH_SALT=remplacer-par-openssl-rand-base64-48

# --- HTTP ---
# Liste blanche d'origines (CORS). « * » est refusé en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Chemin de montage de Socket.IO.
SOCKET_PATH=/socket.io
# Taille maximale du corps d'une requête, en octets (1 Mio).
BODY_LIMIT=1048576
# Limitation de débit : requêtes par fenêtre et par IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Tests (facultatif) ---
# Base séparée pour les tests d'intégration : le harnais TRUNCATE les tables.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uac_live_test
