{
  "name": "@uac/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "10.0.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.3",
    "@socket.io/redis-adapter": "8.3.0",
    "@uac/contracts": "workspace:*",
    "@uac/database": "workspace:*",
    "@uac/geospatial": "workspace:*",
    "@uac/shared": "workspace:*",
    "argon2": "0.44.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.1",
    "ioredis": "5.8.2",
    "pino": "9.13.1",
    "postgres": "3.4.9",
    "socket.io": "4.8.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "pino-pretty": "13.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
